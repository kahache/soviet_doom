// MAPINFO - map/episode definitions (ZDoom "new" MAPINFO syntax).
// Lump name must be MAPINFO; ZDoom wiki: https://zdoom.org/wiki/MAPINFO
//
// Map titles are localized through LANGUAGE (`lookup` = string id).

GameInfo
{
	// Register the mod's ZScript event handlers (class names in zscript/sd/).
	AddEventHandlers = "SD_LoadReporter"

	// The mod's own player class (F4). A player pawn cannot be installed
	// with `replaces`; PlayerClasses is the documented way and it OVERRIDES
	// the previous list, so Freedoom's marine and its weapon slots are gone.
	// ZDoom wiki: MAPINFO/GameInfo definition, "Creating new player classes".
	PlayerClasses = "SD_Player"

	// D43: the title screen plays the Internationale (Jerry Engelbach's
	// sequence, credited in docs/sound/MUSIC-RIGHTS.md 4.5), packed from
	// assets/music/D_SDINTL.mid as music/D_SDINTL.mid. Overrides the IWAD's
	// title music the way PlayerClasses overrides its player.
	// Contract: docs/engine/MOD-SPEC.md 4.5.
	TitleMusic = "D_SDINTL"

	// T24: the status bar is ours so the pause sign can follow the language.
	// SD_StatusBar derives from DoomStatusBar, the class gzdoom.pk3's
	// mapinfo/doomcommon.txt names here, and overrides only DrawPaused, so
	// the bar itself is Doom's. The engine takes the last StatusBarClass by
	// file order and this PK3 loads after gzdoom.pk3 and the IWAD (Freedoom
	// defines none). Contract: docs/engine/MOD-SPEC.md 6.5.1; ADR 010.
	StatusBarClass = "SD_StatusBar"
}

// --- Difficulty ladder ----------------------------------------------------
// The five names are the CEO's (docs/product/DIFFICULTY-NAMES.md owns them);
// LANGUAGE owns the text, this file owns the MECHANICS.
//
// WHY `clearskills`. GZDoom's own mapinfo/doomcommon.txt already defines
// five skills, and every one of them carries a `PicName` (M_JKILL, M_ROUGH,
// M_HURT, M_ULTRA, M_NMARE): the menu then draws the IWAD's GRAPHIC and
// ignores `Name` entirely. Redefining a skill of the same name merges into
// the existing definition, so the PicName would survive and the player would
// still read Freedoom's "Hurt me plenty". `clearskills` drops all five and
// we declare ours from scratch, with no PicName, so the menu renders text.
// ZDoom wiki: MAPINFO/Skill definition.
//
// EVERY MECHANICAL PROPERTY BELOW IS COPIED VERBATIM from GZDoom 4.14.2's
// mapinfo/doomcommon.txt. Renaming a skill must not rebalance the game: the
// damage, ammo and respawn behaviour of each rung is still Doom's. If a
// property here ever diverges from Doom, it belongs in
// docs/engine/BALANCE.md with a reason.
//
//   SpawnFilter  which "skill N" thing flag a map's actors are spawned by:
//                Baby=skill1 ... Nightmare=skill5. Unchanged, so the maps
//                `level-designer` already flagged keep working.
//   AmmoFactor   multiplier on ammo PICKED UP (2 = double, Doom's gift to
//                the easiest and the hardest rung alike).
//   DamageFactor multiplier on damage TAKEN by the player (0.5 = half).
//   RespawnTime  seconds after which a killed monster comes back. This, not
//                a flag, is what makes rung 5 Nightmare.
//   FastMonsters faster monster movement AND faster projectiles.

clearskills

skill sd_pioneer
{
	AutoUseHealth            // auto-drinks medikits when about to die
	AmmoFactor = 2
	DamageFactor = 0.5
	EasyBossBrain
	SpawnFilter = Baby
	Name = "$SD_SKILL_1"
	Key = "i"
}

skill sd_winters
{
	EasyBossBrain
	SpawnFilter = Easy
	Name = "$SD_SKILL_2"
	Key = "h"
}

skill sd_notonestep
{
	SpawnFilter = Normal
	Name = "$SD_SKILL_3"
	Key = "n"
	DefaultSkill             // the rung the menu starts on; Doom's too
}

skill sd_nopasaran
{
	// No discounts: no AmmoFactor, no DamageFactor, no EasyBossBrain.
	SpawnFilter = Hard
	Name = "$SD_SKILL_4"
	Key = "p"
}

skill sd_posthumous
{
	AmmoFactor = 2
	FastMonsters
	InstantReaction          // monsters attack the instant they see you
	DisableCheats
	RespawnTime = 12         // seconds; the dead get back up
	SpawnFilter = Nightmare
	MustConfirm = "$SD_SKILL_5_CONFIRM"
	Name = "$SD_SKILL_5"
	Key = "g"
}

// --- Clusters -------------------------------------------------------------
// A cluster is ZDoom's name for a group of maps that end together. Leaving
// one shows its `exittext` over its `flat`, and that screen is the only
// place the engine will print an end-of-episode message - see the M3 note
// on MAP01. The text is printed only when the game CROSSES from one cluster
// into another (ZDoom wiki, MAPINFO/Cluster definition): two maps in one
// cluster have nothing between them but the stats screen.
//
// D62 (2026-10-14): the map slots follow the campaign. The campaign is
// MAP01 -> MAP02 (the metro) -> MAP03 (the factory, "Tankograd"), and the
// practice range left the MAPxx sequence for the lump RANGE. The rule,
// MOD-SPEC 4.6:
//   cluster 1  the campaign's ENDING; it always holds the campaign's last map
//              (MAP03, the factory, since D62)
//   cluster 2  the practice range's ending (RANGE, D41)
//   cluster 3+ one chapter per earlier campaign map; its exittext is the
//              transition into the next map (cluster 3 = MAP01 -> MAP02,
//              cluster 4 = MAP02 -> MAP03)
// No cluster has an `entertext`: one crossing, one text. That is what keeps
// the ending from being printed anywhere but after the last map.

// The campaign's ending, shown when MAP03 is left (MOD-SPEC 4.6).
cluster 1
{
	// `lookup,` makes the engine resolve the rest as a LANGUAGE id, which
	// is how this text ships in English and Russian (D7).
	exittext = lookup, "SD_END01_TEXT"
	// The text is drawn over this flat, tiled. SDFLR1 is ours and already
	// in the PK3 (approved batch 1), so the ending does not borrow a
	// Freedoom floor to say goodbye on.
	flat = "SDFLR1"
	// The ending text is read in silence: no lump for it yet (D43 has an
	// intermission cue, D_SDTITL, still a candidate).
	music = ""
}

// The practice range (D41): RANGE is its own cluster, so leaving it does
// not print the campaign's ending, and its text tells the player where the
// campaign is. Reached by the range's exit switch behind the start (commit
// d1e891f; MOD-SPEC 4.4). The console `exit` quits GZDoom instead.
cluster 2
{
	exittext = lookup, "SD_END02_TEXT"
	flat = "SDFLR1"
	music = ""
}

// MAP01's chapter (D60): leaving Zarya-7 down the service lift, into the
// metro. Shown after MAP01's stats screen and before MAP02 loads.
cluster 3
{
	exittext = lookup, "SD_MAP01_EXIT_TEXT"
	flat = "SDFLR1"
	music = ""
}

// MAP02's chapter (D62): out of the metro's westbound tunnel at the goods
// spur of the tractor works. Shown after MAP02's stats screen and before
// MAP03 loads.
cluster 4
{
	exittext = lookup, "SD_MAP02_EXIT_TEXT"
	flat = "SDFLR1"
	music = ""
}

clearepisodes

episode MAP01
{
	// "$ID" strings are resolved through LANGUAGE (verified: `lookup` is
	// not accepted inside an episode block by GZDoom 4.14.2).
	name = "$SD_EP01_NAME"
	key = "s"
}

// D41 (CEO, 2026-10-13: "Se puede publicar como practica"): the weapons test
// range ships as a second episode, outside the campaign. With two episodes
// New Game shows the episode screen, which the engine skipped while there
// was one; MENUDEF redeclares it as text so Freedoom's M_EPISOD ("Which
// episode?") is never drawn. Contract: docs/engine/MOD-SPEC.md 4.4; the
// choice against a main-menu item: docs/engine/adr/007-practice-range-as-a-second-episode.md.
//
// D62: the range is the lump RANGE, not a MAPxx slot. A map name that is not
// MAPxx is plain MAPINFO: GZDoom 4.14.2's own mapinfo/doom2bfg.txt opens its
// second episode the same way (`episode level01`, maps LEVEL01-LEVEL09 in
// mapinfo/doom2.txt). A non-MAPxx map has no level number, which only
// Teleport_NewMap and -warp use; neither reaches the range.
episode RANGE
{
	name = "$SD_EP02_NAME"
	key = "p"
}

map MAP01 lookup "SD_MAP01_NAME"
{
	// M3, asked for by `level-designer` 2026-10-13 and closed here.
	// MAP01 used to say `next = "MAP01"`, which made the exit switch
	// restart the map in silence: the engine really did finish the level
	// and really did load the next one, and the next one was this one.
	// It was the right placeholder for verifying Exit_Normal and the wrong
	// thing to ship.
	//
	// D5 said v1 was ONE map, so the exit ENDED THE GAME with `endtitle`,
	// ZDoom's named end sequence for "roll the ending, then go back to the
	// title screen" (gzdoom 4.14.2, FMapInfoParser::CheckEndSequence,
	// src/intermission/intermission_parse.cpp:865). D60 (2026-10-14) grows
	// the campaign: MAP01 now leads into the metro (MAP02 since D62), and
	// `endtitle` moved to the campaign's last map, MAP03.
	//
	// THE WORDS ARE NOT HERE, AND CANNOT BE. The obvious spelling,
	//     next = EndGame { Text = "$SD_END01_TEXT" Pic = "TITLEPIC" }
	// does not parse: an endgame block accepts only `pic`, `hscroll`,
	// `vscroll`, `cast` and `music` (ParseEndGame, same file), and GZDoom
	// answered with "Unknown property 'Text' found in endgame definition"
	// - tried in-engine 2026-10-13. In ZDoom the end-of-episode text
	// belongs to the CLUSTER, not to the map, so it lives in a cluster
	// block and the map only says which cluster it is in.
	//
	// D60: cluster 3, not 1. Cluster 1 holds the ending and the ending is
	// the last map's; leaving cluster 3 for MAP02's cluster 4 prints cluster
	// 3's transition text (SD_MAP01_EXIT_TEXT) and nothing else.
	cluster = 3
	next = "MAP02"
	// D43: our own MAP01 theme, packed from assets/music/D_SDM01.mid. Still
	// never an IWAD lump: the mod depends on no Freedoom music. Every music
	// value in this file is "" or a packed lump (tests/test_mapinfo_music.py),
	// because a misspelt one plays nothing and logs nothing.
	music = "D_SDM01"
	// SKY1 exists in both doom2.wad and freedoom2.wad. The room has no sky
	// ceiling, but the engine still wants a valid sky texture per map.
	sky1 = "SKY1"
	// M4: the intermission's target time, in seconds. 210 is
	// `level-designer`'s figure for a player who knows the route
	// (docs/levels/MAP01-zarya-7.md). It is a display value only - nothing
	// in the game behaves differently - so it can move when QA times the
	// real thing. The stats screen itself is now reached: `nointermission`
	// was dropped with the loop, because an exit that shows no result is
	// the silence M3 is about.
	//
	// NOT VERIFIED: that the screen prints 3:30. The PAR row appears (the
	// engine draws label and value only when partime is non-zero -
	// gzdoom.pk3:zscript/ui/statscreen/statscreen_sp.zs:168,220), but the
	// value is a counter that animates upward, and in four unattended runs
	// it was still climbing when the shot was taken (2:47, 5:17, 2:02...).
	// Reading the settled number needs a human holding the key down; it is
	// on QA's list and it is cosmetic either way.
	par = 210
}

// --- Editor numbers (F4) --------------------------------------------------
// A DoomEdNum is the number a map editor writes into a thing so the engine
// knows what to spawn. ZScript classes can ONLY get one here (ZDoom wiki,
// "Editor number"). Soviet Doom reserves 21000-21999; see
// docs/engine/MOD-SPEC.md for why 14000-14999 was rejected.
//   21000-21019  weapons      21020-21039  ammo and items
//   21100-21199  enemies      21200-21299  decorations

map MAP02 lookup "SD_MAP02_NAME"
{
	// The metro-bunker (docs/levels/MAP02-metro.md), the campaign's second
	// map. Built as MAP03 while MAP02 was the practice range (D41); D62
	// (2026-10-14) gave it the slot of its place in the campaign. MAP01's
	// exit leads here through cluster 3's transition text; its own exit
	// leads to MAP03, the factory, through cluster 4's (MOD-SPEC 4.6).
	cluster = 4
	next = "MAP03"
	music = "D_SDFUNR"	// D62 draft, pending the CEO's ear (SOUNDTRACK.md 0)
	sky1 = "SKY1"
	par = 300
}

map MAP03 lookup "SD_MAP03_NAME"
{
	// The tractor works that builds tanks, Tankograd (D63; the Russian title
	// is in LANGUAGE; docs/levels/MAP03-factory.md): the campaign's third
	// and last map, the episode's climax at the portal. Built as MAP04 (D60), renumbered by
	// D62. It holds cluster 1, so leaving it - by the breaker that feeds the
	// portal - prints the campaign's ending (SD_END01_TEXT), and `endtitle`
	// goes back to the title screen.
	cluster = 1
	next = endtitle
	music = "D_SDGATE"	// D62 draft, pending the CEO's ear (SOUNDTRACK.md 0)
	sky1 = "SKY1"
	// level-designer's estimate for a player who knows the route
	// (docs/levels/MAP03-factory.md 3 and 11). Display only.
	par = 360
}

DoomEdNums
{
	21001 = SD_IceAxe         // slot 1; the shovel until D40, same number
	21002 = SD_Tokarev
	21003 = SD_Izh
	21004 = SD_Ppsh
	21005 = SD_Rpg7
	21006 = SD_Roks3
	21007 = SD_HandKatyusha

	// The arsenal is exactly seven weapons (D13). Doom's chainsaw and super
	// shotgun have no Soviet counterpart, so their editor numbers spawn
	// nothing: a stray Freedoom pickup can never reintroduce them.
	82 = None     // SuperShotgun
	2005 = None   // Chainsaw

	// Bestiary (F5, docs/engine/BESTIARY.md 2.5): the enemy sub-range.
	// Each class also `replaces` its Doom counterpart, so a map may place
	// either number; both spawn ours. 21108 is reserved (cloaked hound).
	21100 = SD_ReichRifleman        // replaces ZombieMan (3004)
	21101 = SD_LegionTrooper        // replaces ShotgunGuy (9)
	21102 = SD_Stormtrooper         // replaces DoomImp (3001)
	21103 = SD_ReichHound           // replaces Demon (3002)
	21104 = SD_Doughboy             // replaces Cacodemon (3005)
	21105 = SD_Panzermensch         // replaces HellKnight (69)
	21106 = SD_General              // replaces Cyberdemon (16)
	21107 = SD_PanzermenschSchwer   // replaces BaronOfHell (3003)
	21200 = SD_Radio                // diegetic radio (MOD-SPEC 6.7, ADR 008)
}

map RANGE lookup "SD_RANGE_NAME"
{
	// Built as the engineering test range (F4), to prove every weapon can be
	// picked up, fired and made to do damage; titled "Training Ground" since
	// D46 (both languages in LANGUAGE). Shipped as the practice range (D41):
	// the second episode on New Game, outside the campaign. It was MAP02
	// until D62 (2026-10-14) gave the MAPxx slots to the campaign; the lump
	// is RANGE now, and `MAP=RANGE tools/run.sh` starts it directly.
	//
	// It used to say `next = "MAP02"`, which restarted the range - harmless
	// for a fixture, wrong for something a player chose from a menu. Now the
	// exit ends the range like the last map's ends the campaign: cluster 2's text,
	// then the title screen. No map's `next` names RANGE, so the campaign
	// can never run into it (tests/test_practice_range.py).
	cluster = 2
	next = endtitle
	music = "D_SDAMUR"	// D62 draft, pending the CEO's ear (SOUNDTRACK.md 0)
	sky1 = "SKY1"
	nointermission
}
