// --- Keys (the metro, MAP02 since D62; 2026-10-14) ------------------------
// The metro's blue pass, SD_BluePass (zscript/sd/keys.zs), which replaces
// Doom's BlueCard; docs/engine/MOD-SPEC.md 6, "The blue pass". Two
// mechanisms again, as for the ammunition above:
//
//  * The pickup line is our own id: Freedoom's DEHACKED overrides the
//    engine's GOTBLUECARD, and DEHACKED beats LANGUAGE (ADR 003).
//
//  * The locked-door lines are ENGINE ids. Lock 2 (gzdoom.pk3 ->
//    lockdefs.txt) prints "$PD_BLUEC" when the door is pressed directly
//    (Door_LockedRaise with tag 0) and "$PD_BLUECO" when the press works a
//    door by tag, as the metro's blast door does (tag 4: a_doors.cpp passes
//    `remote = tag != 0` to P_CheckKeys). Freedoom's DEHACKED does NOT touch
//    PD_BLUECO, so this override is what the player reads at the metro's door.
//    It DOES override PD_BLUEC ("Blue passcard needed for this door."), and
//    that wins over these lines in every language: PD_BLUEC below shows on
//    doom2.wad only. A tag-0 blue door on Freedoom would need a LOCKDEFS of
//    our own (MOD-SPEC 6, "The blue pass"); no map has one.
SD_PICKUP_BLUEPASS = "Blue pass.";
PD_BLUEC           = "You need a blue pass to open this door";
PD_BLUECO          = "You need a blue pass to activate this object";

// Tankograd's yellow and red passes (MAP03, D80): SD_YellowPass and
// SD_RedPass in zscript/sd/keys.zs, locks 3 and 1. The same two mechanisms:
// MAP03's coloured doors work by tag, so the player reads PD_YELLOWCO and
// PD_REDCO, which Freedoom's DEHACKED does not touch; it does override
// PD_YELLOWC and PD_REDC ("... passcard needed for this door."), so the two
// lines below show on doom2.wad only.
SD_PICKUP_YELLOWPASS = "Yellow pass.";
SD_PICKUP_REDPASS    = "Red pass.";
PD_YELLOWC           = "You need a yellow pass to open this door";
PD_YELLOWCO          = "You need a yellow pass to activate this object";
PD_REDC              = "You need a red pass to open this door";
PD_REDCO             = "You need a red pass to activate this object";

// --- Quit messages (M4 shell, audit H5; 2026-10-20) -------------------------
// The engine draws one of GameInfo's `quitmessages` at random when the player
// quits. gzdoom.pk3's mapinfo/doomcommon.txt lists "$QUITMSG".."$QUITMSG14",
// and Freedoom's DEHACKED overrides all fifteen plus DOSY ("(Press Y to exit
// the program.)") in English, which beats LANGUAGE in every language (ADR
// 003; the override table is searched first, src/common/engine/
// stringtable.cpp CheckString, g4.14.2). So our MAPINFO GameInfo replaces
// the list with "$*SD_QUIT_*": the "$*" form prints the string alone,
// without DOSY appended (src/menu/doommenu.cpp, CCMD menu_quit, g4.14.2),
// which is why each line below carries its own "press Y" line. Wry, short,
// in the Sergeant's world (docs/product/LORE.md); lines of at most 40
// characters (tests/test_freedoom_text.py).
SD_QUIT_01 = "Leaving your post, Sergeant?\nThe Urals will not hold themselves.\n\n(Press Y to quit.)";
SD_QUIT_02 = "Russia is vast, but there is nowhere\nto retreat. Moscow is behind us.\n\n(Press Y to quit.)";
SD_QUIT_03 = "The five-year plan is not fulfilled.\nNobody leaves the shift early.\n\n(Press Y to quit.)";
SD_QUIT_04 = "The parade is only days away.\nWho marches if you go home?\n\n(Press Y to quit.)";
SD_QUIT_05 = "The Fourth Reich takes no days off.\nNor does the Liberty Legion.\n\n(Press Y to quit.)";
SD_QUIT_06 = "The canteen closes at eight.\nThe war does not.\n\n(Press Y to quit.)";
SD_QUIT_07 = "Comrade, the Party committee\nwill want an explanation.\n\n(Press Y to quit.)";
SD_QUIT_08 = "Your absence is in the duty log.\nIn pencil, for now.\n\n(Press Y to quit.)";
SD_QUIT_09 = "Barcelona waited forty years.\nThe Urals can wait one evening.\n\n(Press Y to quit.)";
SD_QUIT_10 = "The capitalists are counting on you\nto go home early.\n\n(Press Y to quit.)";
SD_QUIT_11 = "Leave the radio on.\nThe next sentry gets lonely.\n\n(Press Y to quit.)";
SD_QUIT_12 = "Lenin is watching from the wall.\nHe does not look pleased.\n\n(Press Y to quit.)";
SD_QUIT_13 = "Your shift ends\nwhen the invaders do.\n\n(Press Y to quit.)";
SD_QUIT_14 = "Hand your rifle in at the armoury\nand sign for it twice.\n\n(Press Y to quit.)";
