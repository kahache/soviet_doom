// --- The mod's own menu (language switch) ---------------------------------
// The three rows of the language option. "Automatic" is GZDoom's own `auto`:
// the section the operating system's locale selects, and the value in every
// config nobody has touched. It is offered rather than silently rewritten
// because rewriting it needed ZScript, and ZScript may only write a CVar
// while the engine is handling menu input - see the long note in MENUDEF
// and docs/engine/adr/004-language-switch-and-difficulty-ladder.md.

SD_OPTMNU_TITLE    = "Soviet Doom";
SD_OPTMNU_LANGUAGE = "Language";
SD_OPTMNU_LANGHELP = "Applies immediately. Saved for the next session.";

SD_LANGVAL_AUTO = "Automatic (system)";
