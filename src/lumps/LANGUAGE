// --- Ammunition (CEO decision 2026-10-13) ---------------------------------
// The four ammo pools are the IWAD's own classes (Clip, Shell, RocketAmmo,
// Cell); the mod does not create new pools, it renames what the player sees.
//
// Two different mechanisms, because the engine offers two:
//
//  * AMMO_* are ENGINE string ids (gzdoom.pk3 defines each ammo class's Tag
//    as "$AMMO_...").  Overriding them here is legal - a PK3 loaded after
//    the engine wins - and Freedoom's DEHACKED does not touch these ids.
//    NOTE: the stock Doom status bar and the alt-HUD never print an ammo
//    Tag, so this is invisible today; it is set so the pool name exists in
//    exactly one place for when we own the status bar.
//
//  * The pickup LINES are NOT set through the engine's GOTCLIP/GOTSHELLS
//    ids.  Freedoom overrides those from its DEHACKED lump, and on GZDoom
//    4.14.2 a DEHACKED [STRINGS] replacement BEATS a LANGUAGE lump loaded
//    afterwards (verified in-engine 2026-10-13: our GOTCLIPBOX was ignored
//    and Freedoom's "Picked up a case of bullets." was printed).  The mod
//    therefore declares its own pickup actors in zscript/sd/ammo.zs with
//    SD_GOT_* ids Freedoom knows nothing about.
//    See docs/engine/adr/003-ammo-naming-and-the-silent-shovel.md.
//
// SCRIPT: the CEO asked for the Cyrillic designations (D17).  They are in
// the Russian section below.  The English section still carries the Latin
// transliteration a 1977 Soviet manual would also print, for a reason that
// no longer holds: until 2026-10-13 Freedoom's SmallFont was ASCII only
// (GZDoom's glyph pack lives under filter/doom.id/, which Freedoom does not
// select; verified in-engine: "ПГ-7В" printed as " -7B") - debt T9.  D24
// paid T9 the same day with the mod's own glyphs (fonts/defsmallfont/,
// fonts/bigfont/ in the PK3).  Switching these lines to the Cyrillic forms
// is debt T17 in MOD-SPEC 10: a text change, the ASCII test in
// tests/test_language.py, and an engine pass to see it on the HUD.

AMMO_CLIP    = "7.62x25 rounds";       // TT-33 and PPSh-41 share the pistol round
AMMO_SHELLS  = "12 gauge shells";      // IZh-58
AMMO_ROCKETS = "PG-7V rounds";         // an RPG-7 round is a "vystrel", not a rocket
AMMO_CELLS   = "Fuel";                 // ROKS-3 fuel; the hand Katyusha shares the pool

SD_GOT_CLIP      = "A magazine. 7.62x25.";
SD_GOT_CLIPBOX   = "A box of 7.62x25.";
SD_GOT_SHELLS    = "Four shells. 12 gauge.";
SD_GOT_SHELLBOX  = "A box of 12 gauge shells.";
SD_GOT_ROCKET    = "One PG-7V round.";
SD_GOT_ROCKBOX   = "A crate of PG-7V rounds.";
SD_GOT_CELL      = "A canister of fuel.";
SD_GOT_CELLPACK  = "A full fuel tank.";
SD_GOT_BACKPACK  = "Quartermaster's satchel. Everything you can carry!";

// --- Difficulty ladder (CEO decision 2026-10-13) --------------------------
// The five names the CEO chose; the reasoning for each is in
// docs/product/DIFFICULTY-NAMES.md, which owns them. Here they are only
// strings: MAPINFO's `skill` blocks point at these ids with Name = "$SD_SKILL_N".
