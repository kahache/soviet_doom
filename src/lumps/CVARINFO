// CVARINFO - the mod's own console variables. ZDoom wiki: https://zdoom.org/wiki/CVARINFO
//
// One line per variable: <scope> [noarchive] <type> <name> = <default>;
//   server  a gameplay setting: one value for the game, which the host
//           (in single player, the player) changes; GZDoom keeps it in the
//           player's ini (archived) unless `noarchive` is given.
//
// Until V3 the mod had none (MOD-SPEC 10, debt T7): the language row of
// Options > Soviet Doom writes the engine's own `language` (ADR 004).
//
// sd_reloads (V3 experiment, D132; ADR 014; docs/engine/2026-10-25_V3_reloads.md):
// magazines and reloads for the TT-33 (8), the PPSh-41 (71), the AKM (30)
// and the ROKS-3 (an 80-jet tank), and the +reload key for the IZh-58 after
// one barrel. ON by default on the branch v3-reload so the CEO plays it
// first; 0 is the game exactly as v1.2 (zscript/weapons/magazine.zs).
// The row in the menu: MENUDEF, SD_OptionsMenu. From the console:
// `sd_reloads 0` / `sd_reloads 1`, at any moment, also mid-fight.
server bool sd_reloads = true;

// sd_touch (Android, D137; ADR 015; docs/engine/2026-10-27_A1_mod-touch-adaptations.md):
// "this engine is driven by a touch layer". The Android app passes
// `+sd_touch 1` on the command line at every launch; the mod only READS
// it (zscript/sd/touch.zs) and swaps the lines that name a key for lines
// that name a touch button ("Tap USE to continue"), and moves its own
// readouts clear of the corners the stick and the buttons cover. `user`:
// a presentation setting of this client, not a rule of the game.
// `noarchive`: never written to the player's ini, so a desktop config
// stays as it was and a phone gets it from the app, launch by launch.
// Default false = a desktop: v1.3 exactly.
user noarchive bool sd_touch = false;
