# build output
dist/
# GZDoom logs written by tools/run.sh
logs/
# IWADs are never committed (doom2.wad is commercial; freedoom2.wad is downloaded)
iwads/
*.wad
!src/maps/*.wad
# python
__pycache__/
*.pyc
# macOS
.DS_Store
.venv/
# art work-in-progress (batch PNGs live embedded in docs/art/previews; only approved files go to assets/)
work/*
# ...except the downloaded music candidates: for music the file IS the
# artefact and its provenance is external, so a clean checkout must have it
# (D43; docs/sound/MUSIC-RIGHTS.md 4.4). Owner: sound-designer.
!work/audio/
work/audio/*
!work/audio/candidates/
# coverage.py output (tools/coverage.sh); already caught by logs/ above,
# spelled out explicitly since it is its own deliverable (docs/qa/COVERAGE.md)
logs/coverage/
